{
  "name": "telegram-food-bot-frontend-new",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Primary Rocket Lunch frontend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod-dev": "vite build --watch --mode development",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "eslint src --max-warnings 0",
    "audit:prod": "node scripts/audit-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile-chromium",
    "test:e2e:smoke": "playwright test --project=mobile-chromium --grep @smoke",
    "test:e2e:full": "playwright test",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:ui": "playwright test --ui --project=mobile-chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@sentry/react": "^10.49.0",
    "@tanstack/react-query": "^5.99.1",
    "axios": "^1.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
