# ===============================================
# 🎨 FRONTEND DEVELOPMENT CONFIGURATION
# ===============================================
# Используется для локальной разработки с Vite dev server

# API Backend URL - использовать proxy через Vite
# Vite автоматически проксирует /api на localhost:3001
VITE_API_URL=/api

# Telegram Bot Username
VITE_BOT_USERNAME=rocket_lunch_bot

# Environment
VITE_NODE_ENV=development

# ===============================================
# 🧪 TESTING MODE
# ===============================================
# Включите MOCK API для тестирования БЕЗ бэкенда
# Полезно для тестирования на мобильном телефоне
VITE_USE_MOCK_API=false

# ===============================================
# 📊 ERROR TRACKING & ANALYTICS
# ===============================================
# Sentry DSN для error tracking (получить на https://sentry.io)
# Оставьте пустым для development или если не используете Sentry
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
VITE_APP_VERSION=2.0.0
