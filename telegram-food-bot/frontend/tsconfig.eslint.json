{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".storybook/**/*.ts",
    "*.config.ts",
    "vite.config.prod-dev.ts"
  ],
  "exclude": ["dist", "dev-dist", "coverage", "node_modules"]
}
