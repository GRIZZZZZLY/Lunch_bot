# ===============================================
# 🚀 PRODUCTION ENVIRONMENT
# ===============================================
# Конфигурация для production через ngrok

# ===============================================
# DATABASE - SQLite для простоты
# ===============================================
DATABASE_URL=file:./prisma/dev.db

# ===============================================
# TELEGRAM BOT - Polling режим (без webhook)
# ===============================================
BOT_TOKEN=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
BOT_USERNAME=rocket_lunch_bot
BOT_MODE=polling

# ⚠️ Webhook НЕ используется - используем polling для production через ngrok
BOT_WEBHOOK_URL=

# ===============================================
# TELEGRAM WEBAPP
# ===============================================
# Используем BOT_TOKEN для валидации WebApp initData
TELEGRAM_SECRET_KEY=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
WEBAPP_URL=https://epicritic-uninspiredly-makai.ngrok-free.dev

# ===============================================
# API SERVER
# ===============================================
API_PORT=3001
API_HOST=127.0.0.1

# ===============================================
# ENVIRONMENT
# ===============================================
NODE_ENV=production

# ===============================================
# LOGGING
# ===============================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# ===============================================
# SECURITY
# ===============================================
# 🔐 SECURITY: Криптографически стойкий JWT_SECRET (128 символов)
# Сгенерирован через: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=1e1cd5f02f991e068756264c7b1e9bb70dfa5036ab5c9bb298e6fc92a9f5fc92f95460e8dcc3e0abf49b11898c7ad0584c0cd42509388b001cbd18248bab8b7b
CORS_ORIGIN=https://epicritic-uninspiredly-makai.ngrok-free.dev

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
ADMIN_USER_IDS=555502880

# ===============================================
# NOTIFICATION SETTINGS
# ===============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5

# ===============================================
# POLL SETTINGS
# ===============================================
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# ===============================================
# FILE UPLOAD SETTINGS
# ===============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ===============================================
# DEVELOPMENT MODE - TESTING WITH NGROK
# ===============================================
# ⚠️ ДЛЯ ТЕСТИРОВАНИЯ через ngrok: валидация отключена
# ✅ ВАЖНО: Использует РЕАЛЬНЫЕ данные пользователя из Telegram
# ⚠️ Для production сервера установить false!
SKIP_TELEGRAM_VALIDATION=false
TEST_USER_ID=555502880

# ⚠️ ВРЕМЕННО для отладки: пропускать проверку подписи но использовать реальные данные
# Включить только если есть проблемы с валидацией подписи
# Данные пользователя всё равно берутся НАСТОЯЩИЕ из Telegram WebApp
SKIP_SIGNATURE_CHECK=true

