# ===============================================
# 🚀 DEVELOPMENT ENVIRONMENT
# ===============================================
# Конфигурация для локальной разработки и тестирования

# ===============================================
# DATABASE - SQLite для простоты
# ===============================================
DATABASE_URL=file:./prisma/dev.db

# ===============================================
# TELEGRAM BOT - Polling режим (без webhook)
# ===============================================
BOT_TOKEN=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
BOT_USERNAME=rocket_lunch_bot
BOT_MODE=polling

# ⚠️ Webhook НЕ используется - используем polling для production через ngrok
BOT_WEBHOOK_URL=

# ===============================================
# TELEGRAM WEBAPP
# ===============================================
# Используем BOT_TOKEN для валидации WebApp initData
TELEGRAM_SECRET_KEY=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
WEBAPP_URL=https://weighty-untreacherously-christina.ngrok-free.dev

# ===============================================
# API SERVER
# ===============================================
API_PORT=3001
API_HOST=127.0.0.1

# ===============================================
# ENVIRONMENT
# ===============================================
NODE_ENV=production

# ===============================================
# LOGGING
# ===============================================
LOG_LEVEL=info
LOG_FORMAT=dev

# ===============================================
# SECURITY
# ===============================================
# 🔐 SECURITY: Криптографически стойкий JWT_SECRET (128 символов)
# Сгенерирован через: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=1e1cd5f02f991e068756264c7b1e9bb70dfa5036ab5c9bb298e6fc92a9f5fc92f95460e8dcc3e0abf49b11898c7ad0584c0cd42509388b001cbd18248bab8b7b
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://weighty-untreacherously-christina.ngrok-free.dev

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
ADMIN_USER_IDS=555502880

# ===============================================
# NOTIFICATION SETTINGS
# ===============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5

# ===============================================
# POLL SETTINGS
# ===============================================
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# ===============================================
# FILE UPLOAD SETTINGS
# ===============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ===============================================
# DEVELOPMENT MODE - SKIP VALIDATION
# ===============================================
# ⚠️ ТОЛЬКО ДЛЯ РАЗРАБОТКИ!
# Пропускает валидацию Telegram initData и CORS проверки
# Позволяет открывать WebApp с любого устройства через ngrok
# ⚠️ Для локальной разработки через ngrok установите true
# ⚠️ Для реального production на сервере установите false!
SKIP_TELEGRAM_VALIDATION=true
TEST_USER_ID=555502880

