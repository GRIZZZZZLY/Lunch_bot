{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/scripts/**/*"
  ]
}
