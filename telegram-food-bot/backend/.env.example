# ===============================================
# 🚀 ENVIRONMENT TEMPLATE
# ===============================================
# Скопируйте этот файл в .env и заполните реальными значениями

# ===============================================
# DATABASE
# ===============================================
DATABASE_URL=file:./prisma/dev.db

# ===============================================
# TELEGRAM BOT
# ===============================================
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
BOT_WEBHOOK_URL=

# ===============================================
# PROXY SETTINGS (для обхода блокировок Telegram API)
# ===============================================
# Включить использование прокси
USE_PROXY=false
# HTTP/HTTPS прокси: http://user:pass@host:port или http://host:port
# SOCKS5 прокси: socks5://user:pass@host:port или socks5://host:port
PROXY_URL=

# Локальный Telegram Bot API сервер (альтернатива прокси)
USE_LOCAL_API=false
LOCAL_API_URL=http://localhost:8081

# ===============================================
# TELEGRAM WEBAPP
# ===============================================
TELEGRAM_SECRET_KEY=your_bot_token_here
WEBAPP_URL=http://localhost:5173

# ===============================================
# API SERVER
# ===============================================
API_PORT=3001
API_HOST=127.0.0.1

# ===============================================
# ENVIRONMENT
# ===============================================
NODE_ENV=development

# ===============================================
# LOGGING
# ===============================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# ===============================================
# 🔐 SECURITY - CRITICAL!
# ===============================================
# JWT_SECRET: ОБЯЗАТЕЛЬНО замените на сильный ключ!
# Для генерации используйте:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET_64_PLUS_CHARACTERS

# CORS Origins (разделенные запятой)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ===============================================
# FEATURE FLAGS
# ===============================================
FEATURE_MULTI_WINNER=true

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
# Telegram ID администраторов (разделенные запятой)
ADMIN_USER_IDS=123456789

# ===============================================
# NOTIFICATION SETTINGS
# ===============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5

# ===============================================
# POLL SETTINGS
# ===============================================
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# ===============================================
# FILE UPLOAD SETTINGS
# ===============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ===============================================
# ⚠️ DEVELOPMENT MODE - ТОЛЬКО ДЛЯ РАЗРАБОТКИ!
# ===============================================
# SKIP_TELEGRAM_VALIDATION: пропускает проверку Telegram подписи
# ❌ НИКОГДА не используйте в production! Приложение крашнется.
# ✅ Используйте только для локальной разработки
SKIP_TELEGRAM_VALIDATION=false
TEST_USER_ID=123456789

# ===============================================
# 📊 MONITORING (опционально)
# ===============================================
# Sentry DSN для error tracking
# SENTRY_DSN_BACKEND=https://your-dsn@sentry.io/project-id
