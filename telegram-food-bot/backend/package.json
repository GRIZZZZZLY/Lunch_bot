{
    "name": "telegram-food-bot-backend",
    "version": "1.0.0",
    "description": "Backend for Telegram Food Bot with Grammy and Express",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "build:prod": "tsc --project tsconfig.production.json",
        "build:watch": "tsc --watch",
        "start": "node dist/index.js",
        "start:watch": "nodemon dist/index.js",
        "prod-dev": "npm run build && npm run start:watch",
        "dev": "tsx watch src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write src",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "tsx src/database/seeders/seed-menu.ts",
        "db:seed:clear": "tsx src/database/seeders/seed-menu.ts --clear",
        "close-expired-polls": "tsx src/scripts/close-expired-polls.ts",
        "check-polls": "tsx src/scripts/check-polls.ts",
        "fix-poll-11": "tsx src/scripts/fix-poll-11.ts",
        "make-admin": "tsx src/scripts/make-admin.ts",
        "list-users": "tsx src/scripts/list-users.ts",
        "add-test-group": "tsx src/scripts/add-test-group.ts",
        "check-groups": "tsx src/scripts/check-groups.ts",
        "delete-group": "tsx src/scripts/delete-group.ts",
        "test:flow": "node test-app-flow.js"
    },
    "keywords": [
        "telegram",
        "bot",
        "grammy",
        "express",
        "food",
        "voting",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@sentry/node": "^10.22.0",
        "@sentry/profiling-node": "^10.22.0",
        "@telegram-apps/init-data-node": "^2.0.10",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node-cache": "^4.1.3",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "grammy": "^1.38.3",
        "helmet": "^7.1.0",
        "https-proxy-agent": "^7.0.6",
        "ioredis": "^5.8.2",
        "jsonwebtoken": "^9.0.3",
        "lru-cache": "^11.2.4",
        "node-cache": "^5.1.2",
        "node-cron": "^3.0.3",
        "prom-client": "^15.1.3",
        "socks-proxy-agent": "^8.0.5",
        "winston": "^3.18.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.16",
        "@types/express": "^4.17.21",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.9.0",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^6.12.0",
        "@typescript-eslint/parser": "^6.12.0",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "jest-mock-extended": "^4.0.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.1.0",
        "prisma": "^5.6.0",
        "prisma-mock": "^0.12.2",
        "supertest": "^6.3.4",
        "ts-jest": "^29.4.5",
        "tsx": "^4.4.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
