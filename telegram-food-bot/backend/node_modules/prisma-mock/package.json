{
  "name": "prisma-mock",
  "version": "0.12.2",
  "description": "Mock prisma for unit testing database",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demonsters/prisma-mock.git"
  },
  "license": "MIT",
  "types": "lib/",
  "files": [
    "lib/"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@prisma/client": "6.11.1",
    "@types/jest": "^27.0.2",
    "cross-spawn": "^7.0.3",
    "env-cmd": "^10.1.0",
    "jest": "^27.3.1",
    "prisma": "6.11.1",
    "ts-jest": "^27.0.7",
    "typescript": "^4.4.4",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "preversion": "jest && tsc",
    "lint": "tsc --noEmit",
    "build": "tsc",
    "test": "jest",
    "generate": "prisma generate",
    "release": "yarn build && changeset publish && git push --follow-tags",
    "watch": "tsc --watch",
    "test:postgres": "env-cmd -e postgres jest --maxWorkers=1",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:validate:ci": "changeset status --since=origin/main --verbose"
  },
  "peerDependencies": {
    "@prisma/client": "^3.5.0 || ^4.7.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "jest-mock-extended": "^3.0.6"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
