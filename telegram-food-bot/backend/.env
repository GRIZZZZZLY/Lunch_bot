# ===============================================
# 🔧 PRODUCTION-DEV ENVIRONMENT
# ===============================================
# Гибридный режим: production оптимизация + dev удобство

# ===============================================
# DATABASE
# ===============================================
DATABASE_URL=file:./prisma/dev.db

# ===============================================
# TELEGRAM BOT
# ===============================================
BOT_TOKEN=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
BOT_USERNAME=rocket_lunch_bot
BOT_MODE=polling

BOT_WEBHOOK_URL=

# ===============================================
# PROXY SETTINGS (для обхода блокировок Telegram API)
# ===============================================
# ⚠️ ВАЖНО: В России Telegram API может быть заблокирован!
# Включите прокси или локальный API сервер для работы бота
USE_PROXY=false
# Примеры:
# HTTP: http://proxy.example.com:8080
# HTTP с авторизацией: http://user:password@proxy.example.com:8080
# SOCKS5: socks5://proxy.example.com:1080
PROXY_URL=

# Локальный Telegram Bot API сервер (альтернатива прокси)
# https://github.com/tdlib/telegram-bot-api
USE_LOCAL_API=false
LOCAL_API_URL=http://localhost:8081

# ===============================================
# TELEGRAM WEBAPP
# ===============================================
TELEGRAM_SECRET_KEY=8298516078:AAF3QAaoVURt634PcNtwMKiExF2nILnziGk
WEBAPP_URL=http://localhost:3001

# ===============================================
# API SERVER
# ===============================================
API_PORT=3001
API_HOST=127.0.0.1

# ===============================================
# ENVIRONMENT
# ===============================================
# ⚠️ development для разработки, но с production-like оптимизацией frontend
NODE_ENV=development

# ===============================================
# LOGGING - подробное логирование для отладки
# ===============================================
LOG_LEVEL=info
LOG_FORMAT=dev

# ===============================================
# SECURITY
# ===============================================
JWT_SECRET=1e1cd5f02f991e068756264c7b1e9bb70dfa5036ab5c9bb298e6fc92a9f5fc92f95460e8dcc3e0abf49b11898c7ad0584c0cd42509388b001cbd18248bab8b7b
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
ADMIN_USER_IDS=555502880

# ===============================================
# NOTIFICATION SETTINGS
# ===============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5

# ===============================================
# POLL SETTINGS
# ===============================================
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# ===============================================
# FILE UPLOAD SETTINGS
# ===============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ===============================================
# REDIS CACHE (опционально для dev режима)
# ===============================================
# Отключить Redis для локальной разработки (работает без кэша)
REDIS_ENABLED=false

# ===============================================
# PROD-DEV MODE - SKIP VALIDATION для удобства
# ===============================================
# Пропускает валидацию для ngrok, но использует production build
SKIP_TELEGRAM_VALIDATION=true
TEST_USER_ID=555502880
