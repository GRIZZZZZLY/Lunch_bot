/**
 * Создание финального сообщения голосования
 */
function createFinalPollMessage(poll: any, result: any): string {
  let message = `🏁 **Голосование завершено!**\n\n`;
  message += `📊 **"${poll.title}"**\n\n`;
  
  if (result.totalVotes > 0) {
    message += `👥 Участников: ${result.totalVotes}\n`;
    if (result.winnerMenuItem) {
      message += `🏆 **Победитель:** ${result.winnerMenuItem.name}\n\n`;
    }
  } else {
    message += `😔 Никто не проголосовал\n\n`;
  }

  message += `⏰ Завершено: ${new Date().toLocaleString('ru-RU')}\n`;
  return message;
}

/**
 * Создание клавиатуры для завершенного голосования
 */
function createFinalPollKeyboard(pollId: number, result: any): any {
  const keyboard = [
    [
      { text: '📊 Подробные результаты', callback_data: `show_results:${pollId}` }
    ]
  ];

  if (result.totalVotes > 0 && !result.isRouletteRun) {
    keyboard.push([
      { text: '🎲 Запустить рулетку', callback_data: `run_roulette:${pollId}` }
    ]);
  }

  return { inline_keyboard: keyboard };
}




