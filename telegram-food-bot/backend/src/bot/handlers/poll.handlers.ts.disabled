/**
 * Обновление сообщения голосования
 */
async function updatePollMessage(ctx: CallbackQueryContext<BotContext>, pollId: number): Promise<void> {
    if (!poll) return;

    const votes = await VoteService.getPollVotes(pollId);
    const menuItems = await MenuService.getActiveMenuItems();

    // Группируем голоса по блюдам
    const votesByItem = new Map<number, any[]>();
    votes.forEach(vote => {
      const existing = votesByItem.get(vote.menuItemId) || [];
      existing.push(vote);
      votesByItem.set(vote.menuItemId, existing);
    });

    // Создаем обновленное сообщение
    const message = createPollMessage({
      poll,
      menuItems,
      votes: votesByItem,
      totalVotes: votes.length,
    });

    const keyboard = createPollKeyboard(pollId, menuItems, votesByItem);

    // Обновляем сообщение
    await ctx.editMessageText(message, {
      parse_mode: 'Markdown',
      reply_markup: keyboard,
    });

  } catch (error) {
    logger.error('Error updating poll message:', error);
  }
}

/**
 * Обработчик завершения голосования
 */
export async function handleCompletePoll(
  ctx: CallbackQueryContext<BotContext>, 
  pollId: number
): Promise<void> {
  try {
    const user = ctx.from;
    if (!user) {
      await ctx.answerCallbackQuery('❌ Не удалось определить пользователя');
      return;
    }

    // Проверяем права администратора
    const isAdmin = await UserService.isAdmin(user.id.toString());
    const chat = ctx.chat;

    if (!isAdmin && chat) {
      try {
        const member = await ctx.api.getChatMember(chat.id, user.id);
        if (!['administrator', 'creator'].includes(member.status)) {
          await ctx.answerCallbackQuery('❌ Недостаточно прав для завершения голосования');
          return;
        }
      } catch {
        await ctx.answerCallbackQuery('❌ Не удалось проверить права');
        return;
      }
    }

    // Завершаем голосование
    const result = await PollService.completePoll(pollId);
    
    await ctx.answerCallbackQuery('✅ Голосование завершено');
    
    // Показываем результаты
    await handleShowResults(ctx, pollId);

  } catch (error) {
    if (error instanceof Error && error.message === 'Poll is already completed') {
      await ctx.answerCallbackQuery('❌ Голосование уже завершено');
      return;
    }
    
    logger.error('Error completing poll:', error);
    await ctx.answerCallbackQuery('❌ Ошибка при завершении голосования');
  }
}

/**
 * Обработчик обновления голосования
 */
export async function handleRefreshPoll(
  ctx: CallbackQueryContext<BotContext>, 
  pollId: number
): Promise<void> {
  try {
    await updatePollMessage(ctx, pollId);
    await ctx.answerCallbackQuery('🔄 Голосование обновлено');
  } catch (error) {
    logger.error('Error refreshing poll:', error);
    await ctx.answerCallbackQuery('❌ Ошибка при обновлении');
  }
}




