import { CallbackQueryContext } from 'grammy';
import { BotContext } from '../types';
import { logger } from '../../utils/logger';

/**
 * Temporary stub file for poll handlers
 * TODO: Implement full functionality
 */

export async function handleStartPoll(ctx: BotContext): Promise<void> {
  try {
    await ctx.reply('⚠️ Poll functionality is temporarily unavailable. Coming soon!');
    logger.info('Poll start requested but not implemented');
  } catch (error) {
    logger.error('Error in handleStartPoll:', error);
  }
}

export async function handleVote(
  ctx: CallbackQueryContext<BotContext>,
  pollId: number,
  menuItemId: number
): Promise<void> {
  try {
    await ctx.answerCallbackQuery('⚠️ Voting is temporarily unavailable');
    logger.info('Vote requested but not implemented');
  } catch (error) {
    logger.error('Error in handleVote:', error);
  }
}

