# ===============================================
# 🎨 FRONTEND CONFIGURATION
# ===============================================
# Используйте .env.development для локальной разработки

# API Backend URL (production/tunnel)
# Используем ngrok для доступа с мобильного:
VITE_API_URL=https://729301492e9e.ngrok-free.app/api
# Для локальной разработки на ПК:
# VITE_API_URL=https://729301492e9e.ngrok-free.app/api
# VITE_API_URL=https://729301492e9e.ngrok-free.app/api

# Telegram Bot Username
VITE_BOT_USERNAME=rocket_lunch_bot

# Environment
VITE_NODE_ENV=production

# ===============================================
# 🧪 DEVELOPMENT / TESTING MODE
# ===============================================
# Включите MOCK API для тестирования БЕЗ бэкенда
# Полезно для тестирования на мобильном телефоне
VITE_USE_MOCK_API=false
