# ===============================================
# SECURITY - NEVER COMMIT THESE FILES
# ===============================================

# Environment files with secrets
**/.env
**/.env.local
**/.env.*.local
.env
.env.local
.env.*.local

# IMPORTANT: Keep example files
!**/.env.example
!.env.example

# Backup environment files (from scripts)
**/.env.backup

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub

# SSL certificates
*.crt
*.cert
*.ca-bundle

# ===============================================
# Dependencies
# ===============================================
**/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===============================================
# Build outputs
# ===============================================
**/dist/
**/build/
**/.next/
**/out/
*.tsbuildinfo

# ===============================================
# Testing
# ===============================================
**/coverage/
**/.nyc_output/
*.lcov
**/*.test.db
**/*.test.sqlite

# ===============================================
# IDE & Editors
# ===============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ===============================================
# Operating System
# ===============================================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===============================================
# Logs
# ===============================================
**/logs/
**/*.log

# ===============================================
# Database
# ===============================================
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
!**/*.example.db

# Keep production DB backups out of git
**/backups/*.db*

# ===============================================
# Temporary files
# ===============================================
**/tmp/
**/temp/
*.tmp
*.temp

# ===============================================
# Docker
# ===============================================
.dockerignore.bak

# ===============================================
# Cache directories
# ===============================================
.cache/
**/.cache/
.parcel-cache/
.vite/

# ===============================================
# Package manager locks (include these)
# ===============================================
# Uncomment if you want to ignore lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ===============================================
# Miscellaneous
# ===============================================
*.bak
*.orig
*.rej
.history/
