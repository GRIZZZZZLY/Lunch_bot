migrate-simple.ts

# Backups
backups/
backup-*.sql
backup-*.sql.gz
*.bak
*.backup
*.backup2
*.broken
*.old
*.orig

# OS
Thumbs.db
.DS_Store

# ngrok
ngrok.exe
ngrok.yml

# Prisma
# NB: migration.sql files MUST be committed — required for `prisma migrate deploy` on prod

# Production secrets
*.pem
*.key
*.cert
cloudflared/*.json
nginx/certs/
nginx/letsencrypt/

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# AI tooling data (designs, prompts, generated agent artifacts)
.agent/
ai-docs/
.superpowers/

# Caveman compress backups
*.original.md

# Design state snapshots (redesign HTML captures)
.tmp-*-states/
.tmp-*/

# Temporary frontend dist built by the server tests; removed in afterAll, but a
# crashed run leaves it behind and it must never reach a commit
backend/tmp-frontend-*/

# Ad-hoc lint/build report artifacts
backend_out.txt
backend/backend_out.txt
eslint-*-report.json
backend/eslint-*-report.json

# Timestamped DB backups (e.g. prod.db.backup-2026-02-03T...)
*.db.backup-*
backend/prisma/*.db.backup-*

# Scratch SQL
backend/check.sql

# Runtime artifacts (process captures, pid files)
backend.pid
*.pid
stderr.txt
stdout.txt

# Local Claude Code permissions (per-developer)
.claude/settings.local.json

# Локальное состояние дизайн-инструмента (снимки отчётов, конфиг live-режима)
.impeccable/

# Repowise index (локальный кэш/БД, регенерируется repowise init)
.repowise/
