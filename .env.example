# Database Configuration
POSTGRES_USER=foodbot
POSTGRES_PASSWORD=foodbot_password
POSTGRES_DB=foodbot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://foodbot:foodbot_password@localhost:5432/foodbot_db

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
BOT_WEBHOOK_URL=https://yourdomain.com/webhook

# Telegram WebApp Configuration
TELEGRAM_SECRET_KEY=your_telegram_secret_key_here

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api
VITE_BOT_USERNAME=your_bot_username

# Environment
NODE_ENV=development

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:5173

# Docker Ports
HTTP_PORT=80
HTTPS_PORT=443

# Admin Configuration
ADMIN_USER_IDS=123456789,987654321

# Notification Settings
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5

# Poll Settings
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=/app/uploads
