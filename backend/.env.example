# Rocket Lunch: пример переменных окружения
# Скопируйте файл в .env. Не сохраняйте реальные ключи в Git.

# Режим процесса
NODE_ENV=development
PROCESS_ROLE=full
FRONTEND_DIR=frontend-new

# PostgreSQL
DATABASE_URL=postgresql://foodbot:replace_me@127.0.0.1:5432/foodbot

# Telegram
BOT_TOKEN=000000000:replace_with_real_bot_token
BOT_MODE=polling
BOT_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_BOT_USERNAME=
WEBAPP_URL=http://localhost:5174
POLLING_TIMEOUT=30

# HTTP API
API_HOST=127.0.0.1
API_PORT=3001
API_BODY_LIMIT=256kb
API_REQUEST_TIMEOUT_MS=30000
API_HEADERS_TIMEOUT_MS=35000
API_KEEP_ALIVE_TIMEOUT_MS=5000
CORS_ORIGIN=http://localhost:5174
TRUST_PROXY=false
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=5
AUTH_RATE_LIMIT_MAX=50

# Доступ и шифрование
# Сгенерировать JWT_SECRET:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_random_characters_before_production
# Ровно 64 шестнадцатеричных символа. После записи зашифрованных данных
# менять ключ можно только по отдельной процедуре ротации.
ENCRYPTION_KEY=
SKIP_TELEGRAM_VALIDATION=false

# Redis обязателен в production: он обеспечивает идемпотентность и
# распределённые блокировки. REDIS_URL имеет приоритет над полями ниже.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Опасные служебные операции выключены по умолчанию. Для временного включения
# нужны одновременно глобальная роль администратора и отдельный секрет.
ENABLE_OPERATIONS_API=false
OPERATIONS_API_SECRET=

# Наблюдаемость
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_SENTRY=false
SENTRY_DSN=
SENTRY_RELEASE=

# Необязательный прокси
USE_PROXY=false
PROXY_URL=
HTTPS_PROXY=
SOCKS_PROXY=
USE_LOCAL_API=false
LOCAL_API_URL=http://127.0.0.1:8081

# Функции приложения
FEATURE_MULTI_WINNER=true
NOTIFICATION_ENABLED=true
NOTIFICATION_DELAY_MINUTES=5
POLL_DURATION_MINUTES=30
AUTO_ROULETTE_ENABLED=true

# Плановые задания
STORE_RUN_AUTOCLOSE_CRON=* * * * *
GROUP_RECONCILE_CRON=0 */6 * * *
# Группы (id через запятую), которые сверка с Telegram не трогает. Нужно для
# фикстур мониторинга: у них выдуманный чат, Telegram отвечает «chat not found»,
# и сверка гасит группу как покинутую. Пусто = сверять все.
GROUP_RECONCILE_SKIP_IDS=
