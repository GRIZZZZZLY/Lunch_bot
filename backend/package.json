{
  "name": "telegram-food-bot-backend",
  "version": "1.0.0",
  "description": "Backend for Telegram Food Bot with Grammy and Express",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.production.json",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:watch": "nodemon dist/index.js",
    "prod-dev": "npm run build && npm run start:watch",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/database/seeders/seed-menu.ts",
    "db:seed:clear": "tsx src/database/seeders/seed-menu.ts --clear",
    "close-expired-polls": "tsx src/scripts/close-expired-polls.ts",
    "check-polls": "tsx src/scripts/check-polls.ts",
    "fix-poll-11": "tsx src/scripts/fix-poll-11.ts",
    "make-admin": "tsx src/scripts/make-admin.ts",
    "list-users": "tsx src/scripts/list-users.ts",
    "add-test-group": "tsx src/scripts/add-test-group.ts",
    "check-groups": "tsx src/scripts/check-groups.ts",
    "delete-group": "tsx src/scripts/delete-group.ts",
    "test:flow": "node test-app-flow.js",
    "db:migrate:sqlite-to-postgres": "tsx src/scripts/migrate-sqlite-to-postgres.ts",
    "backup": "powershell -ExecutionPolicy Bypass -File ../backup-postgres.ps1",
    "backup:compress": "powershell -ExecutionPolicy Bypass -File ../backup-postgres.ps1 -Compress",
    "restore": "powershell -ExecutionPolicy Bypass -File ../restore-postgres.ps1",
    "knip": "knip --include files,dependencies,unlisted,unresolved,catalog,cycles --treat-config-hints-as-errors",
    "db:validate": "prisma validate",
    "db:format:check": "prisma format --check",
    "db:migrate:test": "node scripts/verify-test-migrations.mjs",
    "e2e:seed": "tsx src/scripts/e2e-seed.ts seed",
    "e2e:cleanup": "tsx src/scripts/e2e-seed.ts cleanup",
    "any:check": "node scripts/check-any-count.mjs"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "express",
    "food",
    "voting",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@prisma/client": "7.9.1",
    "@sentry/node": "^10.37.0",
    "@sentry/profiling-node": "^10.37.0",
    "@types/pg": "^8.20.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "grammy": "^1.39.3",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "socks-proxy-agent": "^8.0.5",
    "winston": "^3.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.16",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.9.0",
    "@types/supertest": "^6.0.3",
    "better-sqlite3": "^12.6.2",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "knip": "6.27.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.64.0"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.0.0"
  },
  "overrides": {}
}
