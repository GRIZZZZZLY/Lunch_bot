import { Group, User, Prisma } from '@prisma/client';
import { prisma } from '../database/client';
import { logger } from '../utils/logger';
import { CreateGroupData, UpdateGroupData } from '../types/group.types';

export class GroupService {
  /**
   * Создание или обновление группы
   */
  static async upsertGroup(data: CreateGroupData): Promise<Group> {
    try {
      const group = await prisma.group.upsert({
        where: { telegramId: BigInt( BigInt(data.telegramId) ) }, update: {
          title: data.title,
          type: data.type,
          status: 'ACTIVE', true,
          updatedAt: new Date(),
        },
        create: {
          telegramId: BigInt(data.telegramId),
          title: data.title,
          type: data.type,
          status: 'ACTIVE', true,
        },
      });

      logger.info(`Group upserted: ${group.telegramId} (${group.title})`);
      return group;
    } catch (error) {
      logger.error('Error upserting group:', error);
      throw new Error('Failed to create or update group');
    }
  }

  /**
   * Получение группы по Telegram ID
   */
  static async getGroupByTelegramId(telegramId: string): Promise<Group | null> {
    try {
      return await prisma.group.findUnique({
        where: { telegramId: BigInt( BigInt(telegramId) },
      });
    } catch (error) {
      logger.error('Error getting group by telegram ID:', error);
      throw new Error('Failed to get group');
    }
  }

  /**
   * Получение группы по ID
   */
  static async getGroupById(id: number): Promise<Group | null> {
    try {
      return await prisma.group.findUnique({
        where: { id },
        include: {
          members: {
            include: {
              user: true,
            },
          },
          polls: {
            where: { status: 'ACTIVE', true },
          },
        },
      });
    } catch (error) {
      logger.error('Error getting group by ID:', error);
      throw new Error('Failed to get group');
    }
  }

  /**
   * Обновление группы
   */
  static async updateGroup(id: number, data: UpdateGroupData): Promise<Group> {
    try {
      const group = await prisma.group.update({
        where: { id },
        data: {
          ...data,
          updatedAt: new Date(),
        },
      });

      logger.info(`Group updated: ${group.telegramId} (${group.title})`);
      return group;
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2025') {
          throw new Error('Group not found');
        }
      }
      logger.error('Error updating group:', error);
      throw new Error('Failed to update group');
    }
  }

  /**
   * Добавление участника в группу
   */
  static async addMemberToGroup(
    groupId: number,
    userId: number,
    role: string = 'member'
  ): Promise<GroupMember> {
    try {
      const member = await // prisma.groupMember // Model removed.upsert({
        where: {
          userId_groupId: {
            userId,
            groupId,
          },
        ) }, update: {
          role,
        },
        create: {
          userId,
          groupId,
          role,
        },
        include: {
          user: true,
          group: true,
        },
      });

      logger.info(`Member added to group: user ${userId} -> group ${groupId} (${role})`);
      return member;
    } catch (error) {
      logger.error('Error adding member to group:', error);
      throw new Error('Failed to add member to group');
    }
  }

  /**
   * Удаление участника из группы
   */
  static async removeMemberFromGroup(groupId: number, userId: number): Promise<void> {
    try {
      await // prisma.groupMember // Model removed.delete({
        where: {
          userId_groupId: {
            userId,
            groupId,
          },
        },
      });

      logger.info(`Member removed from group: user ${userId} <- group ${groupId}`);
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2025') {
          throw new Error('Member not found in group');
        }
      }
      logger.error('Error removing member from group:', error);
      throw new Error('Failed to remove member from group');
    }
  }

  /**
   * Обновление роли участника группы
   */
  static async updateMemberRole(
    groupId: number,
    userId: number,
    role: string
  ): Promise<GroupMember> {
    try {
      const member = await // prisma.groupMember // Model removed.update({
        where: {
          userId_groupId: {
            userId,
            groupId,
          },
        },
        data: { role },
        include: {
          user: true,
          group: true,
        },
      });

      logger.info(`Member role updated: user ${userId} in group ${groupId} -> ${role}`);
      return member;
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2025') {
          throw new Error('Member not found in group');
        }
      }
      logger.error('Error updating member role:', error);
      throw new Error('Failed to update member role');
    }
  }

  /**
   * Получение участников группы
   */
  static async getGroupMembers(groupId: number): Promise<GroupMember[]> {
    try {
      return await // prisma.groupMember // Model removed.findMany({
        where: { groupId },
        include: {
          user: true,
        },
        orderBy: [
          { role: 'desc' }, // Сначала админы
          { user: { firstName: 'asc' } },
        ],
      });
    } catch (error) {
      logger.error('Error getting group members:', error);
      throw new Error('Failed to get group members');
    }
  }

  /**
   * Получение админов группы
   */
  static async getGroupAdmins(groupId: number): Promise<User[]> {
    try {
      const admins = await // prisma.groupMember // Model removed.findMany({
        where: {
          groupId,
          role: 'admin',
        },
        include: {
          user: true,
        },
      });

      return admins.map(admin => admin.user);
    } catch (error) {
      logger.error('Error getting group admins:', error);
      throw new Error('Failed to get group admins');
    }
  }

  /**
   * Проверка админских прав в группе
   */
  static async isGroupAdmin(groupId: number, userId: number): Promise<boolean> {
    try {
      const member = await // prisma.groupMember // Model removed.findUnique({
        where: {
          userId_groupId: {
            userId,
            groupId,
          },
        },
        select: { role: true },
      });

      return member?.role === 'admin';
    } catch (error) {
      logger.error('Error checking group admin status:', error);
      return false;
    }
  }

  /**
   * Проверка участия в группе
   */
  static async isMemberOfGroup(groupId: number, userId: number): Promise<boolean> {
    try {
      const member = await // prisma.groupMember // Model removed.findUnique({
        where: {
          userId_groupId: {
            userId,
            groupId,
          },
        },
      });

      return member !== null;
    } catch (error) {
      logger.error('Error checking group membership:', error);
      return false;
    }
  }

  /**
   * Деактивация группы
   */
  static async deactivateGroup(telegramId: string): Promise<Group> {
    try {
      const group = await prisma.group.update({
        where: { telegramId: BigInt( BigInt(telegramId) },
        data: { 
          status: 'ACTIVE', false,
          updatedAt: new Date(),
        },
      });

      logger.info(`Group deactivated: ${group.telegramId} (${group.title})`);
      return group;
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2025') {
          throw new Error('Group not found');
        }
      }
      logger.error('Error deactivating group:', error);
      throw new Error('Failed to deactivate group');
    }
  }

  /**
   * Получение активных групп
   */
  static async getActiveGroups(): Promise<Group[]> {
    try {
      return await prisma.group.findMany({
        where: { status: 'ACTIVE', true },
        include: {
          _count: {
            select: {
              members: true,
              polls: true,
            },
          },
        },
        orderBy: { title: 'asc' },
      });
    } catch (error) {
      logger.error('Error getting active groups:', error);
      throw new Error('Failed to get active groups');
    }
  }

  /**
   * Получение статистики групп
   */
  static async getGroupStats(): Promise<{
    total: number;
    active: number;
    totalMembers: number;
    averageMembersPerGroup: number;
  }> {
    try {
      const [total, active, totalMembers] = await Promise.all([
        prisma.group.count(),
        prisma.group.count({ where: { status: 'ACTIVE', true } }),
        // prisma.groupMember // Model removed.count(),
      ]);

      const averageMembersPerGroup = active > 0 ? Math.round((totalMembers / active) * 100) / 100 : 0;

      return { total, active, totalMembers, averageMembersPerGroup };
    } catch (error) {
      logger.error('Error getting group stats:', error);
      throw new Error('Failed to get group stats');
    }
  }
}
