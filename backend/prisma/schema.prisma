generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                     @id @default(autoincrement())
  telegramId                BigInt                  @unique @map("telegram_id")
  username                  String?
  firstName                 String                  @map("first_name")
  lastName                  String?                 @map("last_name")
  photoUrl                  String?                 @map("photo_url")
  avatarUrl                 String?                 @map("avatar_url")
  avatarUpdatedAt           DateTime?               @map("avatar_updated_at")
  isAdmin                   Boolean                 @default(false) @map("is_admin")
  isActive                  Boolean                 @default(true) @map("is_active")
  participatesInPolls       Boolean                 @default(true) @map("participates_in_polls")
  paymentCard               String?                 @map("payment_card")
  paymentPhone              String?                 @map("payment_phone")
  paymentDetails            String?                 @map("payment_details")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  createdMenuItems          MenuItem[]
  responsiblePolls          PollResult[]
  createdPolls              Poll[]                  @relation("PollCreator")
  votes                     Vote[]
  debts                     Transaction[]           @relation("UserDebts")
  credits                   Transaction[]           @relation("UserCredits")
  responsibleSelections     ResponsibleSelection[]  @relation("ResponsibleUser")
  volunteerSelections       ResponsibleSelection[]  @relation("VolunteerUser")
  rouletteWins              ResponsibleSelection[]  @relation("RouletteWinner")
  sentReminders             PaymentReminder[]
  adminReminders            AdminReminder[]
  groupMemberships          GroupMember[]
  menuSuggestions           MenuSuggestion[]        @relation("SuggestionCreator")
  reviewedSuggestions       MenuSuggestion[]        @relation("SuggestionReviewer")
  progress                  UserProgress?
  stats                     UserStats?              @relation("UserStats")
  achievements              UserAchievement[]
  challengeProgress         UserChallengeProgress[]
  quests                    UserQuest[]             @relation("UserQuests")
  createdRecurringPolls     RecurringPoll[]
  xpHistory                 XPHistory[]             @relation("UserXPHistory")
  createdReminderSettings   DebtReminderSettings[]  @relation("ReminderSettingsCreator")
  responsibleCategoryOrders CategoryOrder[]         @relation("ResponsibleCategoryOrders")
  orderedItems              OrderItem[]             @relation("OrderItemUser")
  enteredItems              OrderItem[]             @relation("OrderItemEnteredBy")
  editLogs                  OrderItemEditLog[]      @relation("OrderItemEditor")
  initiatedStoreRuns        StoreRun[]              @relation("StoreRunInitiator")
  storeItems                StoreItem[]             @relation("StoreItemOwner")
  pollParticipations        PollParticipant[]
  donations                 Donation[]

  @@map("users")
}

model Group {
  id                        Int                        @id @default(autoincrement())
  telegramId                BigInt                     @unique @map("telegram_id")
  title                     String
  type                      String                     @default("group")
  isActive                  Boolean                    @default(true) @map("is_active")
  settings                  String?                    @map("settings_json")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  polls                     Poll[]
  adminReminders            AdminReminder[]
  members                   GroupMember[]
  recurringPolls            RecurringPoll[]
  reminderSettings          DebtReminderSettings?
  adminNotificationSettings AdminNotificationSettings?
  storeRuns                 StoreRun[]
  menuItems                 MenuItem[]
  menuSuggestions           MenuSuggestion[]

  @@map("groups")
}

model MenuItem {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal?
  imageUrl     String?       @map("image_url")
  isActive     Boolean       @default(true) @map("is_active")
  createdBy    Int           @map("created_by")
  groupId      Int           @map("group_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  /* Мягкое удаление. Жёсткое рвало историю: обнуляло menuItemId у всех голосов
     и winnerMenuItemId у всех результатов, из-за чего в завершённых опросах
     пропадал победитель. Блюдо уходит из каталога, связи остаются. */
  deletedAt    DateTime?     @map("deleted_at")
  creator      User          @relation(fields: [createdBy], references: [id])
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pollResults  PollResult[]
  votes        Vote[]
  transactions Transaction[]

  @@index([isActive])
  @@index([groupId, isActive])
  @@index([groupId, deletedAt])
  @@map("menu_items")
}

model Poll {
  id                   Int                   @id @default(autoincrement())
  groupId              Int                   @map("group_id")
  status               String                @default("ACTIVE")
  duration             Int                   @default(30)
  startedAt            DateTime              @default(now()) @map("started_at")
  endedAt              DateTime?             @map("ended_at")
  createdBy            Int                   @map("created_by")
  messageId            Int?                  @map("message_id")
  chatId               BigInt?               @map("chat_id")
  selectedMenuItemIds  String?               @map("selected_menu_item_ids")
  isMultiSelect        Boolean               @default(true) @map("is_multi_select")
  maxSelections        Int                   @default(3) @map("max_selections")
  isAutomatic          Boolean               @default(false) @map("is_automatic")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  result               PollResult?
  creator              User                  @relation("PollCreator", fields: [createdBy], references: [id])
  group                Group                 @relation(fields: [groupId], references: [id])
  votes                Vote[]
  transactions         Transaction[]
  responsibleSelection ResponsibleSelection?
  orderCosts           PollOrderCosts?
  categoryOrders       CategoryOrder[]
  participants         PollParticipant[]

  @@index([status])
  @@index([startedAt])
  @@index([status, startedAt])
  @@index([groupId, status])
  // P0-2: hot path getActivePollsForGroup + history listing — фильтр groupId+status
  // и сортировка по createdAt DESC. Без этого индекса Postgres сначала фильтрует,
  // потом сортирует — на 10k+ polls'ах ощутимо.
  @@index([groupId, status, createdAt(sort: Desc)])
  @@map("polls")
}

model PollParticipant {
  id        Int      @id @default(autoincrement())
  pollId    Int      @map("poll_id")
  userId    Int      @map("user_id")
  status    String   @default("EXPECTED")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId, status])
  @@map("poll_participants")
}

model Vote {
  id           Int       @id @default(autoincrement())
  pollId       Int       @map("poll_id")
  userId       Int       @map("user_id")
  menuItemId   Int?      @map("menu_item_id")
  voteType     String    @default("MENU_ITEM") @map("vote_type")
  customOption String?   @map("custom_option")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  poll         Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, menuItemId])
  @@index([pollId])
  @@index([userId])
  @@index([voteType])
  @@index([pollId, userId])
  @@index([createdAt])
  @@index([menuItemId])
  @@map("votes")
}

model PollResult {
  id                Int       @id @default(autoincrement())
  pollId            Int       @unique @map("poll_id")
  winnerMenuItemId  Int?      @map("winner_menu_item_id")
  responsibleUserId Int       @map("responsible_user_id")
  totalVotes        Int       @default(0) @map("total_votes")
  rouletteData      String?   @map("roulette_data")
  createdAt         DateTime  @default(now()) @map("created_at")
  winnerMenuItem    MenuItem? @relation(fields: [winnerMenuItemId], references: [id])
  responsibleUser   User      @relation(fields: [responsibleUserId], references: [id])
  poll              Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@map("poll_results")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  pollId          Int?      @map("poll_id")
  storeRunId      Int?      @map("store_run_id")
  fromUserId      Int       @map("from_user_id")
  toUserId        Int       @map("to_user_id")
  amount          Decimal
  menuItemId      Int?      @map("menu_item_id")
  categoryOrderId Int?      @map("category_order_id")
  storeItemId     Int?      @map("store_item_id")
  itemPrice       Decimal?  @map("item_price")
  deliveryShare   Decimal?  @map("delivery_share")
  serviceShare    Decimal?  @map("service_share")
  tipShare        Decimal?  @map("tip_share")
  status          String    @default("PENDING")
  paidAt          DateTime? @map("paid_at")
  confirmedAt     DateTime? @map("confirmed_at")
  disputedReason  String?   @map("disputed_reason")
  reminderCount   Int       @default(0) @map("reminder_count")
  lastReminderAt  DateTime? @map("last_reminder_at")
  debtMessageId   Int?      @map("debt_message_id") // Telegram message_id of debt notification
  debtChatId      String?   @map("debt_chat_id") // Telegram chat_id of debt notification
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  poll          Poll?             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  storeRun      StoreRun?         @relation(fields: [storeRunId], references: [id], onDelete: Cascade)
  storeItem     StoreItem?        @relation(fields: [storeItemId], references: [id])
  fromUser      User              @relation("UserDebts", fields: [fromUserId], references: [id])
  toUser        User              @relation("UserCredits", fields: [toUserId], references: [id])
  menuItem      MenuItem?         @relation(fields: [menuItemId], references: [id])
  categoryOrder CategoryOrder?    @relation(fields: [categoryOrderId], references: [id])
  reminders     PaymentReminder[]

  // Защита от гонки при финализации магазинного забега: один StoreItem
  // даёт максимум одну транзакцию. NULL,NULL (poll-транзакции) в Postgres
  // считаются различными, поэтому ограничение их не затрагивает.
  @@unique([storeRunId, storeItemId])
  @@unique([categoryOrderId, fromUserId], map: "transactions_category_order_debtor_key")
  @@index([pollId])
  @@index([storeRunId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([categoryOrderId])
  // P0-2: hot path getPollTotals / poll-cost-breakdown — фильтр pollId+status
  // (PENDING / PAID / CONFIRMED) на тяжёлой таблице транзакций.
  @@index([pollId, status])
  @@map("transactions")
}

model PollOrderCosts {
  id           Int      @id @default(autoincrement())
  pollId       Int      @unique @map("poll_id")
  deliveryCost Decimal  @default(0) @map("delivery_cost")
  serviceFee   Decimal  @default(0) @map("service_fee")
  tip          Decimal  @default(0)
  notes        String?
  enteredBy    Int      @map("entered_by")
  enteredAt    DateTime @default(now()) @map("entered_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@map("poll_order_costs")
}

model ResponsibleSelection {
  id               Int       @id @default(autoincrement())
  pollId           Int       @unique @map("poll_id")
  mode             String
  status           String    @default("WAITING")
  selectedUserId   Int?      @map("selected_user_id")
  volunteerUserId  Int?      @map("volunteer_user_id")
  rouletteWinnerId Int?      @map("roulette_winner_id")
  timeoutAt        DateTime? @map("timeout_at")
  timeoutMinutes   Int       @default(3) @map("timeout_minutes")
  completedAt      DateTime? @map("completed_at")
  messageId        Int?      @map("message_id")
  chatId           BigInt?   @map("chat_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  poll           Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  selectedUser   User? @relation("ResponsibleUser", fields: [selectedUserId], references: [id])
  volunteerUser  User? @relation("VolunteerUser", fields: [volunteerUserId], references: [id])
  rouletteWinner User? @relation("RouletteWinner", fields: [rouletteWinnerId], references: [id])

  @@map("responsible_selections")
}

model PaymentReminder {
  id            Int      @id @default(autoincrement())
  transactionId Int      @map("transaction_id")
  type          String   @default("AUTO")
  sentBy        Int?     @map("sent_by")
  message       String?
  sentAt        DateTime @default(now()) @map("sent_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sender      User?       @relation(fields: [sentBy], references: [id])

  @@map("payment_reminders")
}

model AdminReminder {
  id        Int      @id @default(autoincrement())
  userId    Int
  groupId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, groupId])
  @@index([createdAt])
  @@map("admin_reminders")
}

model GroupMember {
  id                  Int       @id @default(autoincrement())
  groupId             Int       @map("group_id")
  userId              Int       @map("user_id")
  role                String    @default("MEMBER")
  joinedAt            DateTime  @default(now()) @map("joined_at")
  leftAt              DateTime? @map("left_at")
  isActive            Boolean   @default(true) @map("is_active")
  participatesInPolls Boolean   @default(true) @map("participates_in_polls")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, isActive])
  @@index([userId])
  @@map("group_members")
}

model MenuSuggestion {
  id                Int       @id @default(autoincrement())
  name              String
  description       String?
  price             Float?
  imageUrl          String?   @map("image_url")
  status            String    @default("PENDING")
  suggestedBy       Int       @map("suggested_by")
  groupId           Int       @map("group_id")
  reviewedBy        Int?      @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  rejectionReason   String?   @map("rejection_reason")
  createdMenuItemId Int?      @map("created_menu_item_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  suggester User  @relation("SuggestionCreator", fields: [suggestedBy], references: [id])
  reviewer  User? @relation("SuggestionReviewer", fields: [reviewedBy], references: [id])
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([suggestedBy])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([groupId, status])
  @@map("menu_suggestions")
}

// ============================================
// CATEGORY ORDER SYSTEM
// ============================================

model CategoryOrder {
  id                     Int       @id @default(autoincrement())
  pollId                 Int       @map("poll_id")
  category               String
  responsibleUserId      Int?      @map("responsible_user_id")
  selectionStatus        String    @default("PENDING") @map("selection_status")
  calculationStatus      String    @default("PENDING") @map("calculation_status")
  selectionMode          String?   @map("selection_mode")
  participantCount       Int       @default(0) @map("participant_count")
  deliveryCost           Decimal?  @default(0) @map("delivery_cost")
  serviceFee             Decimal?  @default(0) @map("service_fee")
  tip                    Decimal?  @default(0)
  notes                  String?
  totalItemsAmount       Decimal?  @default(0) @map("total_items_amount")
  totalAdditionalCosts   Decimal?  @default(0) @map("total_additional_costs")
  totalAmount            Decimal?  @map("total_amount")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  calculationStartedAt   DateTime? @map("calculation_started_at")
  calculationCompletedAt DateTime? @map("calculation_completed_at")
  participantMessages    String?   @map("participant_messages") // JSON: {userId: {messageId, chatId}}

  poll            Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responsibleUser User?         @relation("ResponsibleCategoryOrders", fields: [responsibleUserId], references: [id])
  orderItems      OrderItem[]
  transactions    Transaction[]

  @@unique([pollId, category])
  @@index([pollId])
  @@index([responsibleUserId])
  @@index([calculationStatus])
  @@index([pollId, calculationStatus])
  @@map("category_orders")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  categoryOrderId Int      @map("category_order_id")
  userId          Int      @map("user_id")
  itemName        String   @map("item_name")
  price           Decimal
  notes           String?
  enteredBy       Int      @map("entered_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  categoryOrder CategoryOrder      @relation(fields: [categoryOrderId], references: [id], onDelete: Cascade)
  user          User               @relation("OrderItemUser", fields: [userId], references: [id])
  enteredByUser User               @relation("OrderItemEnteredBy", fields: [enteredBy], references: [id])
  editLogs      OrderItemEditLog[]

  @@unique([categoryOrderId, userId])
  @@index([categoryOrderId])
  @@index([userId])
  @@index([enteredBy])
  @@map("order_items")
}

model OrderItemEditLog {
  id           Int      @id @default(autoincrement())
  orderItemId  Int      @map("order_item_id")
  editedBy     Int      @map("edited_by")
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  reason       String?
  timestamp    DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  editor    User      @relation("OrderItemEditor", fields: [editedBy], references: [id])

  @@index([orderItemId])
  @@index([editedBy])
  @@index([timestamp])
  @@map("order_item_edit_logs")
}

// ============================================
// GAMIFICATION MODELS
// ============================================

model UserStats {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique @map("user_id")
  totalXP             Int       @default(0) @map("total_xp")
  level               Int       @default(1)
  rank                String    @default("Новичок")
  gastroRating        Int       @default(0) @map("gastro_rating")
  responsibleRating   Int       @default(0) @map("responsible_rating")
  socialRating        Int       @default(0) @map("social_rating")
  explorerRating      Int       @default(0) @map("explorer_rating")
  currentStreak       Int       @default(0) @map("current_streak")
  longestStreak       Int       @default(0) @map("longest_streak")
  lastVoteDate        DateTime? @map("last_vote_date")
  pollsParticipated   Int       @default(0) @map("polls_participated")
  pollsWon            Int       @default(0) @map("polls_won")
  totalVotes          Int       @default(0) @map("total_votes")
  correctPredictions  Int       @default(0) @map("correct_predictions")
  timesResponsible    Int       @default(0) @map("times_responsible")
  timesVolunteer      Int       @default(0) @map("times_volunteer")
  ordersReceived      Int       @default(0) @map("orders_received")
  paymentsOnTime      Int       @default(0) @map("payments_on_time")
  totalSpent          Decimal   @default(0) @map("total_spent")
  totalOrders         Int       @default(0) @map("total_orders")
  newDishesDiscovered Int       @default(0) @map("new_dishes_discovered")
  categoriesTried     Int       @default(0) @map("categories_tried")
  menuItemsAdded      Int       @default(0) @map("menu_items_added")
  referralsCount      Int       @default(0) @map("referrals_count")
  randomChoices       Int       @default(0) @map("random_choices")
  winStreak           Int       @default(0) @map("win_streak")
  maxWinStreak        Int       @default(0) @map("max_win_streak")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation("UserStats", fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXP])
  @@index([level])
  @@index([userId, totalXP])
  @@index([gastroRating])
  @@index([responsibleRating])
  @@index([socialRating])
  @@index([explorerRating])
  @@map("user_stats")
}

model XPHistory {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  amount         Int
  reason         String
  category       String
  seasonId       Int?     @map("season_id")
  metadata       String?
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  user   User    @relation("UserXPHistory", fields: [userId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id])

  @@index([userId])
  @@index([seasonId])
  @@index([createdAt])
  @@index([category])
  @@index([userId, seasonId])
  @@map("xp_history")
}

model UserProgress {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique @map("user_id")
  xp                 Int      @default(0)
  level              Int      @default(1)
  rank               String   @default("Новичок")
  totalVotes         Int      @default(0) @map("total_votes")
  totalOrders        Int      @default(0) @map("total_orders")
  totalSpent         Decimal  @default(0) @map("total_spent")
  winStreak          Int      @default(0) @map("win_streak")
  maxWinStreak       Int      @default(0) @map("max_win_streak")
  categoriesTried    Int      @default(0) @map("categories_tried")
  randomChoices      Int      @default(0) @map("random_choices")
  correctPredictions Int      @default(0) @map("correct_predictions")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
  @@index([level])
  @@index([userId, xp])
  @@map("user_progress")
}

model Achievement {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  title       String
  description String
  icon        String
  category    String
  rarity      String            @default("COMMON")
  xpReward    Int               @default(0) @map("xp_reward")
  requirement String
  isHidden    Boolean           @default(false) @map("is_hidden")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  unlockedBy  UserAchievement[]

  @@index([key])
  @@index([category])
  @@index([rarity])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  achievementId Int      @map("achievement_id")
  progress      Int      @default(100)
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([unlockedAt])
  @@map("user_achievements")
}

model Quest {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  title       String
  description String
  type        String
  category    String
  icon        String
  xpReward    Int         @default(0) @map("xp_reward")
  requirement String
  duration    Int         @default(1)
  rarity      String      @default("COMMON")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userQuests  UserQuest[]

  @@index([key])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@map("quests")
}

model UserQuest {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  questId     Int       @map("quest_id")
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  target      Int
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")

  user  User  @relation("UserQuests", fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, startedAt])
  @@index([userId, status])
  @@index([questId])
  @@index([expiresAt])
  @@index([status])
  @@map("user_quests")
}

model Challenge {
  id          Int                     @id @default(autoincrement())
  title       String
  description String
  type        String
  rarity      String                  @default("common")
  icon        String
  target      String
  reward      String
  deadline    DateTime?
  isActive    Boolean                 @default(true) @map("is_active")
  startDate   DateTime                @default(now()) @map("start_date")
  endDate     DateTime?               @map("end_date")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  progress    UserChallengeProgress[]

  @@index([type])
  @@index([rarity])
  @@index([isActive])
  @@index([deadline])
  @@map("challenges")
}

model UserChallengeProgress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  challengeId Int       @map("challenge_id")
  progress    Int       @default(0)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([isCompleted])
  @@map("user_challenge_progress")
}

model Season {
  id        Int         @id @default(autoincrement())
  number    Int         @unique
  name      String
  theme     String?
  startDate DateTime    @map("start_date")
  endDate   DateTime    @map("end_date")
  isActive  Boolean     @default(false) @map("is_active")
  rewards   String?
  metadata  String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  xpHistory XPHistory[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("seasons")
}

// ============================================
// RECURRING POLLS
// ============================================

model RecurringPoll {
  id                  Int       @id @default(autoincrement())
  groupId             Int       @map("group_id")
  isEnabled           Boolean   @default(true) @map("is_enabled")
  daysOfWeek          String    @map("days_of_week")
  timeOfDay           String    @map("time_of_day")
  duration            Int       @default(30)
  selectedMenuItemIds String?   @map("selected_menu_item_ids")
  lastRunAt           DateTime? @map("last_run_at")
  nextRunAt           DateTime? @map("next_run_at")
  lastRunStatus       String?   @map("last_run_status")
  lastRunMessage      String?   @map("last_run_message")
  createdBy           Int       @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@unique([groupId])
  @@index([isEnabled, nextRunAt])
  @@index([groupId, isEnabled])
  @@map("recurring_polls")
}

model DebtReminderSettings {
  id              Int      @id @default(autoincrement())
  groupId         Int      @unique @map("group_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  intervalDays    Int      @default(3) @map("interval_days")
  messageTemplate String   @map("message_template")
  minDebtAge      Int      @default(1) @map("min_debt_age")
  maxReminders    Int      @default(5) @map("max_reminders")
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation("ReminderSettingsCreator", fields: [createdBy], references: [id])

  @@map("debt_reminder_settings")
}

model AdminNotificationSettings {
  id               Int      @id @default(autoincrement())
  groupId          Int      @unique @map("group_id")
  notifyOnNewUser  Boolean  @default(true) @map("notify_on_new_user")
  notifyOnNewPoll  Boolean  @default(false) @map("notify_on_new_poll")
  notifyOnPollEnd  Boolean  @default(false) @map("notify_on_poll_end")
  notifyOnDebtPaid Boolean  @default(false) @map("notify_on_debt_paid")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("admin_notification_settings")
}

// ============================================
// STORE RUN (Иду в магазин)
// ============================================

model StoreRun {
  id             Int       @id @default(autoincrement())
  groupId        Int       @map("group_id")
  initiatorId    Int       @map("initiator_id")
  storeName      String    @map("store_name")
  status         String    @default("COLLECTING") // COLLECTING | SHOPPING | SETTLED | CANCELLED
  collectUntil   DateTime  @map("collect_until")
  shoppingAt     DateTime? @map("shopping_at")
  settledAt      DateTime? @map("settled_at")
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  groupMessageId Int?      @map("group_message_id")
  dmMessages     String?   @map("dm_messages")

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  initiator    User          @relation("StoreRunInitiator", fields: [initiatorId], references: [id])
  items        StoreItem[]
  transactions Transaction[]

  @@index([groupId, status])
  @@index([status, collectUntil])
  @@index([initiatorId, status])
  @@map("store_runs")
}

// ============================================
// DONATIONS (Поддержите проект)
// ============================================

model Donation {
  id             String    @id @default(cuid())
  userId         Int       @map("user_id")
  amountRub      Int       @map("amount_rub")
  amountStars    Int?      @map("amount_stars")
  amountCrypto   String?   @map("amount_crypto")
  method         String // STARS | WALLET | SBP_MANUAL (legacy free-form)
  // P1-8: нормализованный канал для агрегатной аналитики (Grafana разбивка
  // конверсии Stars / SBP / Wallet / Other). `method` оставлен legacy для
  // backward compat и обогащения текстовыми кодами от провайдеров.
  paymentChannel String?   @map("payment_channel") // STARS | SBP | WALLET | OTHER
  status         String    @default("PENDING") // PENDING | PENDING_MANUAL | CONFIRMED | FAILED | EXPIRED
  externalId     String?   @unique @map("external_id") // Stars chargeId / Wallet orderId
  metadata       String?
  createdAt      DateTime  @default(now()) @map("created_at")
  confirmedAt    DateTime? @map("confirmed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status, method])
  @@index([createdAt])
  // P0-2: user-facing donation history (мой список платежей по статусу).
  @@index([userId, status])
  // P1-8: groupBy(paymentChannel, status) для «conversion by channel».
  @@index([paymentChannel, status])
  @@map("donations")
}

model StoreItem {
  id         Int      @id @default(autoincrement())
  storeRunId Int      @map("store_run_id")
  userId     Int      @map("user_id")
  name       String
  quantity   Int      @default(1)
  notes      String?
  price      Decimal?
  status     String   @default("REQUESTED") // REQUESTED | BOUGHT | NOT_FOUND
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  storeRun     StoreRun      @relation(fields: [storeRunId], references: [id], onDelete: Cascade)
  user         User          @relation("StoreItemOwner", fields: [userId], references: [id])
  transactions Transaction[]

  @@index([storeRunId])
  @@index([userId])
  @@index([storeRunId, userId])
  @@map("store_items")
}
