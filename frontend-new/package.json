{
  "name": "telegram-food-bot-frontend-new",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Primary Rocket Lunch frontend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod-dev": "tsc --noEmit && vite build --mode prod-dev",
    "dev:watch:bundle": "vite build --watch --mode development",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "eslint src --max-warnings 0",
    "audit:prod": "node scripts/audit-production.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile-chromium",
    "test:e2e:smoke": "playwright test --project=mobile-chromium --grep @smoke",
    "test:e2e:full": "playwright test",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:ui": "playwright test --ui --project=mobile-chromium",
    "ui-tour": "playwright test --config=playwright.tour.config.ts",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "size:check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
