# Версия обязана совпадать с @playwright/test из frontend-new/package.json:
# браузеры лежат в образе, и библиотека другой версии их не найдёт. При
# обновлении пакета поднимать и этот тег.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app/frontend-new

COPY --chown=pwuser:pwuser frontend-new/package.json frontend-new/package-lock.json ./
RUN npm ci

COPY --chown=pwuser:pwuser frontend-new/playwright.production.config.ts ./
COPY --chown=pwuser:pwuser frontend-new/tests ./tests

USER pwuser

CMD ["npm", "run", "test:e2e:production"]
