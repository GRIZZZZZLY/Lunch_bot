{
  "name": "telegram-food-bot-frontend",
  "private": true,
  "version": "2.0.1",
  "description": "Frontend Mini App for Telegram Food Bot",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod-dev": "vite build --watch --config vite.config.prod-dev.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip --include files,dependencies,unlisted,unresolved,catalog,cycles --treat-config-hints-as-errors",
    "react-doctor": "react-doctor src --yes --verbose --no-color --blocking warning",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "size:check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "^10.69.0",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.30.4",
    "react-swipeable": "^7.0.2",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.1.0",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^9.1.9",
    "@storybook/addon-onboarding": "^9.1.9",
    "@storybook/react-vite": "^9.1.9",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-storybook": "^9.1.9",
    "globals": "17.8.0",
    "jsdom": "^23.0.1",
    "knip": "6.31.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "react-doctor": "0.9.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^9.1.9",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.0.0"
  }
}
