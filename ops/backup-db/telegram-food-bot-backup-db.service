[Unit]
Description=Резервная копия базы Rocket Lunch
After=postgresql.service network-online.target
Wants=network-online.target
# Копия, о провале которой никто не узнал, — это отсутствие копий.
OnFailure=telegram-food-bot-alert@%n.service

[Service]
Type=oneshot
# User, WorkingDirectory и BACKUP_DIR подставляет ops/backup-db/install-vps.sh.
# От root запускать нечего: копии должны принадлежать тому же пользователю, что
# и остальные файлы приложения, иначе их не прочитать без sudo.
User=root
WorkingDirectory=/opt/telegram-food-bot
Environment=BACKUP_DIR=/opt/telegram-food-bot/backups
# Копий за две недели хватает, чтобы заметить порчу данных и откатиться;
# каждая — около 160 КБ, так что предел здесь про порядок, а не про место.
Environment=KEEP=14
ExecStart=/usr/bin/env bash backup-db.sh
TimeoutStartSec=30min
